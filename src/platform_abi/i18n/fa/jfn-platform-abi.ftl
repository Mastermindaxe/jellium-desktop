settings-log-level-default = پیش‌فرض (Info)
settings-log-level-verbose = مفصل
settings-log-level-debug = اشکال‌زدایی
settings-log-level-warn = هشدار
settings-log-level-error = خطا
settings-open-mpv-config = باز کردن پوشه پیکربندی mpv
settings-reset-server = بازنشانی سرور ذخیره‌شده
